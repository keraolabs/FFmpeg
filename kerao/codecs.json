  "excluded": [
    {
      "codecs": [
        "adpcm_circus",
        "adpcm_ima_escape",
        "adpcm_ima_hvqm2",
        "adpcm_ima_hvqm4",
        "adpcm_ima_magix",
        "adpcm_ima_pda",
        "adpcm_n64",
        "adpcm_psxc"
      ],
      "reason": "Only Streamyfin ships them. Since FFmpeg 8.1, configure gives each of these decoders deps=\"lgpl_gpl\", which only --enable-gpl enables (n9.0.2 configure lines 3129-3138 and 4837). The build stays LGPL-2.1, and the fork keeps no patch to build them."
    },
    {
      "codecs": [
        "sonic"
      ],
      "reason": "FFmpeg 9.0 deleted the sonic decoder. AV_CODEC_ID_SONIC remains, but no decoder can cover it."
    },
    {
      "codecs": [
        "ayuv",
        "v308",
        "v408",
        "v410"
      ],
      "reason": "n9.0.2 has no such AVCodecID. Its demuxers map these FourCCs to rawvideo, which is listed."
    },
    {
      "codecs": [
        "webp_anim"
      ],
      "reason": "AV_CODEC_ID_WEBP_ANIM is an AVCodecID of its own in n9.0.2 (libavcodec/codec_id.h line 326, apart from AV_CODEC_ID_WEBP at line 221), so the research's appendix A.1 counts 267 video IDs with it. Its decoder is new in FFmpeg 9.0 and none of the six players ships it, so it is outside the union and the list keeps section 4's 266. The build decodes it anyway."
    }
  ]
}
